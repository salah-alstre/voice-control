<UserControl x:Class="VoiceCommander.App.Views.DeveloperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:VoiceCommander.App.Infrastructure"
             xmlns:vm="clr-namespace:VoiceCommander.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,28" MaxWidth="900" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PageTitle}" Text="{inf:Loc dev.title}"/>
            <TextBlock Style="{StaticResource Muted}" Text="{inf:Loc dev.subtitle}" Margin="0,4,0,20" TextWrapping="Wrap"/>

            <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,0,0,26">
                <StackPanel>
                    <TextBlock Style="{StaticResource Overline}" Text="{inf:Loc dev.simulate}"/>
                    <TextBlock Style="{StaticResource Muted}" Text="{inf:Loc dev.simulate.hint}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{inf:Loc dev.phrase}" Tag="{inf:Loc dev.phrase}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SimulateCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{inf:Loc dev.confidence}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="{Binding Confidence}"
                                AutomationProperties.Name="{inf:Loc dev.confidence}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding ConfidenceText}" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                    </Grid>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AsVoice}" Content="{inf:Loc dev.asvoice}"
                              AutomationProperties.Name="{inf:Loc dev.asvoice}" Margin="0,12,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{inf:Loc dev.run}" Padding="18,0"
                                Command="{Binding SimulateCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                        <Button Style="{StaticResource GhostButton}" Content="{inf:Loc dev.analyze}" Padding="16,0" Margin="10,0,0,0"
                                Command="{Binding AnalyzeCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Outcome}" Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Outcome, Converter={StaticResource NullToVis}}"/>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,0,0,26" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Overline}" Text="{inf:Loc dev.matcher}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Details}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DetailRow}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,0,0,26">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{inf:Loc dev.reload}" Padding="14,0"
                                Command="{Binding ReloadEnginesCommand}"/>
                        <TextBlock Style="{StaticResource Overline}" Text="{inf:Loc dev.engines}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Engines}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EngineRow}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Language}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,0,0,26">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{inf:Loc common.clear}" Padding="14,0"
                                Command="{Binding ClearRawCommand}"/>
                        <TextBlock Style="{StaticResource Overline}" Text="{inf:Loc dev.raw}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Text="{inf:Loc dev.raw.empty}" TextWrapping="Wrap"
                               Visibility="{Binding RawLines.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding RawLines}" MaxHeight="180" FlowDirection="LeftToRight"
                             AutomationProperties.Name="{inf:Loc dev.raw}">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{inf:Loc common.clear}" Padding="14,0"
                                Command="{Binding ClearLogCommand}"/>
                        <TextBlock Style="{StaticResource Overline}" Text="{inf:Loc dev.log}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="LogList" Style="{StaticResource PlainList}" ItemsSource="{Binding LogLines}" Height="260" FlowDirection="LeftToRight"
                             AutomationProperties.Name="{inf:Loc dev.log}">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

