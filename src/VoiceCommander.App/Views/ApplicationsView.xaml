<UserControl x:Class="VoiceCommander.App.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:VoiceCommander.App.Infrastructure"
             xmlns:vm="clr-namespace:VoiceCommander.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:DetectedItemViewModel}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,14,0"
                          AutomationProperties.Name="{Binding Name}"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AppItemViewModel}">
            <Border Style="{StaticResource HoverRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource IconTile}" Width="36" Height="36" CornerRadius="8" VerticalAlignment="Top" Margin="0,0,14,0">
                        <Grid>
                            <Image Source="{Binding Icon}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding KindText}" Style="{StaticResource Caption}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{inf:Loc apps.builtin}" Style="{StaticResource Caption}" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{Binding StatusBrush, Converter={StaticResource BrushName}}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding PathText}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding PathText}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding AliasesText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding HasAliases, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding MissingText}" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding Missing, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding ResultText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{Binding ResultBrush, Converter={StaticResource BrushName}}"
                                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="{Binding LocateLabel}" Padding="12,0" Margin="0,0,6,0"
                                Command="{Binding LocateCommand}" Visibility="{Binding Missing, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource GhostButton}" Content="{Binding TestLabel}" Padding="12,0" Margin="0,0,4,0"
                                Command="{Binding TestCommand}" IsEnabled="{Binding Testing, Converter={StaticResource InvBool}}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="{inf:Loc common.edit}" Command="{Binding EditCommand}"
                                AutomationProperties.Name="{inf:Loc common.edit}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="{inf:Loc common.delete}" Command="{Binding DeleteCommand}"
                                AutomationProperties.Name="{inf:Loc common.delete}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,28" MaxWidth="900" HorizontalAlignment="Stretch">
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Content="{inf:Loc apps.detect}" Padding="16,0" Margin="0,0,8,0"
                            Command="{Binding DetectCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{inf:Loc apps.add}" Command="{Binding AddCommand}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{inf:Loc apps.title}"/>
                    <TextBlock Style="{StaticResource Muted}" Text="{inf:Loc apps.subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <!-- Auto-detect results -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="16,12" Margin="0,0,0,16" Visibility="{Binding ShowDetect, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="{inf:Loc common.close}"
                                Command="{Binding CloseDetectCommand}" AutomationProperties.Name="{inf:Loc common.close}"/>
                        <TextBlock Text="{Binding DetectText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{inf:Loc apps.detect.hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0"
                                  Visibility="{Binding HasDetected, Converter={StaticResource BoolToVis}}">
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Detected}"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding HasDetected, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource PrimaryButton}" Content="{inf:Loc apps.detect.addselected}" Command="{Binding AddSelectedCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="{inf:Loc apps.selectall}" Padding="14,0" Margin="8,0,0,0"
                                Command="{Binding SelectAllDetectedCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource SearchBox}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{inf:Loc common.search}" ToolTip="{inf:Loc common.search}"/>
                <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </Grid>

            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}"/>

            <Border Padding="32,48" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE71D;" Style="{StaticResource Glyph}" FontSize="28" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="{inf:Loc apps.empty}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
