<UserControl x:Class="VoiceCommander.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:VoiceCommander.App.Infrastructure"
             xmlns:vm="clr-namespace:VoiceCommander.App.ViewModels">
    <UserControl.Resources>
        <!-- Equalizer bars: only animated while the status area is in the Listening state (started/stopped from code-behind). -->
        <Storyboard x:Key="WaveStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="W1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.3" To="1" Duration="0:0:0.45" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="W2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.8" To="0.25" Duration="0:0:0.38" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="W3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.4" To="1" Duration="0:0:0.52" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="W4" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="0.3" Duration="0:0:0.41" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="W5" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.35" To="0.9" Duration="0:0:0.48" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="W6" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.9" To="0.35" Duration="0:0:0.43" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="W7" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.3" To="0.8" Duration="0:0:0.36" AutoReverse="True"/>
        </Storyboard>
        <Style x:Key="WaveBar" TargetType="Rectangle">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="RadiusX" Value="2"/>
            <Setter Property="RadiusY" Value="2"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,28" MaxWidth="900" HorizontalAlignment="Stretch">

            <!-- Header: page label, microphone, open assistant -->
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding OpenAssistantCommand}"
                        VerticalAlignment="Center" Margin="16,0,0,0" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" FontSize="13" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{inf:Loc dash.openassistant}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{inf:Loc dash.header}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center" Margin="0,1,8,0"
                                Background="{Binding StatusDotBrush, Converter={StaticResource BrushName}}"/>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding StatusWord}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Style="{StaticResource Muted}" Text="  ·  "/>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding MicrophoneText}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Setup prompt when no speech model is installed -->
            <Border Style="{StaticResource WarningCard}" Margin="0,12,0,0"
                    Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{inf:Loc dash.setup.action}"
                            Command="{Binding OpenSetupCommand}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <StackPanel>
                        <TextBlock Text="{inf:Loc dash.setup.title}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Style="{StaticResource Muted}" Text="{inf:Loc dash.setup.body}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Central status area: one state at a time (Ready / Listening / Heard / Executing / Success / Error). No card: it sits on the black. -->
            <StackPanel HorizontalAlignment="Center" MinHeight="230" Margin="0,30,0,26">
                <Grid Height="60" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <StackPanel x:Name="Wave" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding CardListening, Converter={StaticResource BoolToVis}}">
                        <Rectangle x:Name="W1" Style="{StaticResource WaveBar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.5"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="W2" Style="{StaticResource WaveBar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.7"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="W3" Style="{StaticResource WaveBar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.9"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="W4" Style="{StaticResource WaveBar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.6"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="W5" Style="{StaticResource WaveBar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="W6" Style="{StaticResource WaveBar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.8"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="W7" Style="{StaticResource WaveBar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.5"/></Rectangle.RenderTransform></Rectangle>
                    </StackPanel>
                    <Border Width="60" Height="60" CornerRadius="30" Background="{DynamicResource Surface2Brush}"
                            Visibility="{Binding CardListening, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <Grid>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE720;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding CardBrush, Converter={StaticResource BrushName}}"
                                       Visibility="{Binding HasCardIcon, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                            <Image Source="{Binding CardIcon}" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasCardIcon, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock Style="{StaticResource Display}" Text="{Binding CardTitle}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" FontSize="28"
                           Foreground="{Binding CardBrush, Converter={StaticResource BrushName}}"/>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding CardSubtitle}" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="560" FontSize="14" Margin="0,8,0,0"
                           Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding HeardLine}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                           FontSize="14" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding ShowHeard, Converter={StaticResource BoolToVis}}"/>

                <Button Style="{StaticResource SecondaryButton}" Content="{Binding RecoveryLabel}" Command="{Binding RunRecoveryCommand}"
                        HorizontalAlignment="Center" Margin="0,14,0,0"
                        Visibility="{Binding HasRecovery, Converter={StaticResource BoolToVis}}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button x:Name="TalkButton" Style="{StaticResource PrimaryButton}" MinWidth="140" Padding="16,9"
                            PreviewMouseLeftButtonDown="OnTalkDown" PreviewMouseLeftButtonUp="OnTalkUp" LostMouseCapture="OnTalkLost"
                            Visibility="{Binding IsPushToTalk, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE720;" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="{inf:Loc dash.holdtotalk}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding ToggleText}" Command="{Binding ToggleListeningCommand}"
                            MinWidth="100" Padding="16,9" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Metrics: three flat figures separated by hairlines -->
            <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,1" Padding="0,16" Margin="0,0,0,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding CommandCount}" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Muted}" Text="{inf:Loc dash.stat.commands}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="1" Background="{DynamicResource SubtleBorderBrush}"/>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding AppCount}" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Muted}" Text="{inf:Loc dash.stat.apps}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Column="3" Width="1" Background="{DynamicResource SubtleBorderBrush}"/>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding TodayCount}" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Muted}" Text="{inf:Loc dash.stat.today}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Recent activity: flat rows -->
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{inf:Loc nav.history}" Command="{Binding OpenHistoryCommand}" Padding="8,4"/>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{inf:Loc dash.recent}" VerticalAlignment="Center" Margin="0"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Muted}" Text="{inf:Loc dash.noactivity}" Margin="0,10,0,4"
                       Visibility="{Binding Recent.Count, Converter={StaticResource ZeroToVis}}"/>
            <ItemsControl ItemsSource="{Binding Recent}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryItemViewModel}">
                        <Border Style="{StaticResource Row}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding OutcomeGlyph}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"
                                           Foreground="{Binding OutcomeBrush, Converter={StaticResource BrushName}}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Heard}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding CommandName, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Message, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Style="{StaticResource Muted}" FontSize="12" Text="{Binding Time}" VerticalAlignment="Top" Margin="12,2,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
