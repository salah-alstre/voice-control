<UserControl x:Class="VoiceCommander.App.Views.CommandsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:VoiceCommander.App.Infrastructure"
             xmlns:vm="clr-namespace:VoiceCommander.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:PackItemViewModel}">
            <Border Style="{StaticResource HoverRow}" Margin="0,0,16,0" Width="262" Padding="4,9">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Style="{StaticResource Glyph}" FontSize="17" Margin="0,0,12,0"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ChipOptionViewModel}">
            <RadioButton Style="{StaticResource FilterChip}" GroupName="CommandFilterChips" Content="{Binding Label}"
                         IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CommandItemViewModel}">
            <Border Style="{StaticResource HoverRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="8" VerticalAlignment="Top" Margin="0,1,14,0">
                        <Grid>
                            <Image Source="{Binding AppIcon}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasAppIcon, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Caption}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource AccentBadge}" Margin="0,0,6,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding StepsText}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <Border Style="{StaticResource WarningBadge}" Margin="0,0,6,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsDangerous, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{inf:Loc cmd.dangerous}" Style="{StaticResource Caption}" Foreground="{DynamicResource WarningBrush}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding PhrasesText}" Style="{StaticResource Secondary}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding DuplicateText}" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding HasDuplicate, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding ResultText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{Binding ResultBrush, Converter={StaticResource BrushName}}"
                                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Margin="0,0,10,0" VerticalAlignment="Center"
                                  AutomationProperties.Name="{inf:Loc common.enabled}" ToolTip="{inf:Loc common.enabled}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="{inf:Loc common.edit}" Command="{Binding EditCommand}"/>
                        <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="{inf:Loc common.more}"
                                Click="OnMoreClick">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{inf:Loc common.test}" Command="{Binding TestCommand}"/>
                                    <MenuItem Header="{inf:Loc common.duplicate}" Command="{Binding DuplicateCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="{inf:Loc common.delete}" Command="{Binding DeleteCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,28" MaxWidth="900" HorizontalAlignment="Stretch">
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding NewLabel}"
                        Command="{Binding NewCommand}" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding PageTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding PageSubtitle}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Search -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource SearchBox}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{inf:Loc cmd.search}" ToolTip="{inf:Loc cmd.search}"/>
                <ComboBox Grid.Column="1" Margin="10,0,0,0" MinWidth="140" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                          Visibility="{Binding ShowChips, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </Grid>

            <!-- Category chips -->
            <ItemsControl ItemsSource="{Binding Chips}" Margin="0,0,0,10"
                          Visibility="{Binding ShowChips, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Packs -->
            <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,1" Padding="0,12" Margin="0,0,0,16" Visibility="{Binding ShowPacks, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{inf:Loc cmd.restoredefaults}" Padding="12,4"
                                Command="{Binding RestoreDefaultsCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding TogglePacksCommand}" HorizontalAlignment="Left" Padding="0">
                            <StackPanel>
                                <TextBlock Text="{inf:Loc cmd.packs}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{inf:Loc cmd.packs.hint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Packs}" Margin="0,10,0,0"
                             Visibility="{Binding PacksExpanded, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding DuplicatesText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding HasDuplicates, Converter={StaticResource BoolToVis}}"/>

            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}"/>

            <Border Padding="24,40" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
