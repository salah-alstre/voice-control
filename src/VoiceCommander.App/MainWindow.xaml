<inf:WindowBase x:Class="VoiceCommander.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:VoiceCommander.App.Infrastructure"
        xmlns:vm="clr-namespace:VoiceCommander.App.ViewModels"
        xmlns:v="clr-namespace:VoiceCommander.App.Views"
        Title="Voice Commander" Width="1120" Height="740" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/app.ico">
    <inf:WindowBase.Resources>
        <!-- One DataTemplate per page: the ViewModel decides which View is shown. -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CommandsViewModel}"><v:CommandsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkflowsViewModel}"><v:CommandsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ApplicationsViewModel}"><v:ApplicationsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MicrophoneViewModel}"><v:MicrophoneView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeveloperViewModel}"><v:DeveloperView/></DataTemplate>
        <DataTemplate x:Key="NavTemplate" DataType="{x:Type vm:NavItemViewModel}">
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                         Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                         Click="OnNavClick" Checked="OnNavClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="15" Width="20"/>
                    <TextBlock Text="{Binding Title}" Margin="10,0,0,0" FontSize="13"/>
                </StackPanel>
            </RadioButton>
        </DataTemplate>
    </inf:WindowBase.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,16,10,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,18">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource AccentBrush}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE720;" FontSize="14" Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Voice Commander" FontWeight="SemiBold" FontSize="13.5"/>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding VersionText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10.5"/>
                    </StackPanel>
                </StackPanel>

                <!-- Footer: Developer / Settings pinned to the bottom, then a flat listening status line -->
                <StackPanel DockPanel.Dock="Bottom">
                    <ItemsControl ItemsSource="{Binding BottomItems}" ItemTemplate="{StaticResource NavTemplate}"/>
                    <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="10,10,6,2"
                            ToolTip="{Binding MicName}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{Binding MicStatusBrush, Converter={StaticResource BrushName}}"/>
                            <StackPanel Margin="9,0,0,0">
                                <TextBlock Text="{Binding MicStatusText}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding MicName}" MaxWidth="132" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding TopItems}" ItemTemplate="{StaticResource NavTemplate}"/>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding Current}" Focusable="False"/>
    </Grid>
</inf:WindowBase>
