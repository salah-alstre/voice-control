<Application x:Class="VoiceCommander.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:VoiceCommander.App.Infrastructure">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 must be the theme dictionary: ThemeService swaps it at runtime. -->
                <ResourceDictionary Source="Themes/Dark.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <inf:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <inf:InverseBoolConverter x:Key="InvBool"/>
            <inf:NullToVisibilityConverter x:Key="NullToVis"/>
            <inf:ZeroToVisibilityConverter x:Key="ZeroToVis"/>
            <inf:LevelToWidthConverter x:Key="LevelToWidth"/>
            <inf:EqualsConverter x:Key="Equals"/>
            <inf:BrushNameConverter x:Key="BrushName"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
