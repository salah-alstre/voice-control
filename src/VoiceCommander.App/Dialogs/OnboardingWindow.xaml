<infra:WindowBase x:Class="VoiceCommander.App.Dialogs.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:VoiceCommander.App.Infrastructure"
        xmlns:vm="clr-namespace:VoiceCommander.App.ViewModels"
        Title="Voice Commander" Width="640" Height="680" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="pack://application:,,,/Resources/app.ico">
    <infra:WindowBase.Resources>
        <DataTemplate DataType="{x:Type vm:ModelItemViewModel}">
            <Border Style="{StaticResource HoverRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0">
                            <Run Text="{Binding LanguageText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{Binding StatusBrush, Converter={StaticResource BrushName}}"/>
                        <ProgressBar Style="{StaticResource ThinProgress}" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,8,0,0"
                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Content="{infra:Loc model.download}" Padding="14,0"
                                Command="{Binding DownloadCommand}"
                                Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource GhostButton}" Content="{infra:Loc model.cancel}" Padding="14,0"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource DangerButton}" Content="{infra:Loc model.remove}" Padding="14,0"
                                Command="{Binding RemoveCommand}"
                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </infra:WindowBase.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: step counter, progress, title, explanation -->
        <StackPanel>
            <DockPanel>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding StepCounter}" FontSize="12"/>
            </DockPanel>
            <ProgressBar Style="{StaticResource ThinProgress}" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,8,0,18"/>
            <TextBlock Style="{StaticResource Title}" Text="{Binding StepTitle}" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource Muted}" Text="{Binding StepBody}" TextWrapping="Wrap" Margin="0,8,0,20"/>
        </StackPanel>

        <!-- One panel per step; only the current one is visible. -->
        <Grid Grid.Row="1">
            <!-- 0 welcome -->
            <StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="18" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE720;" FontSize="34" Foreground="{DynamicResource AccentTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- 1 language -->
            <StackPanel Visibility="{Binding IsLanguageStep, Converter={StaticResource BoolToVis}}">
                <RadioButton Style="{StaticResource Segment}" GroupName="ui-lang" Content="English" Margin="0,0,0,8"
                             IsChecked="{Binding IsEnglishUi, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="en"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="ui-lang" Content="العربية" Margin="0,0,0,8"
                             IsChecked="{Binding IsArabicUi, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="ar"/>
            </StackPanel>

            <!-- 2 speech profile -->
            <StackPanel Visibility="{Binding IsProfileStep, Converter={StaticResource BoolToVis}}">
                <RadioButton Style="{StaticResource Segment}" GroupName="profile" Content="{infra:Loc profile.english}" Margin="0,0,0,8"
                             IsChecked="{Binding IsProfileEnglish, Mode=OneWay}" Command="{Binding SetProfileCommand}" CommandParameter="English"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="profile" Content="{infra:Loc profile.arabic}" Margin="0,0,0,8"
                             IsChecked="{Binding IsProfileArabic, Mode=OneWay}" Command="{Binding SetProfileCommand}" CommandParameter="Arabic"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="profile" Content="{infra:Loc profile.mixed}" Margin="0,0,0,8"
                             IsChecked="{Binding IsProfileMixed, Mode=OneWay}" Command="{Binding SetProfileCommand}" CommandParameter="Mixed"/>
            </StackPanel>

            <!-- 3 model -->
            <ScrollViewer Visibility="{Binding IsModelStep, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding VisibleModels}" Focusable="False"/>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Style="{StaticResource GhostButton}" Padding="14,0" Margin="0,0,10,6"
                                Command="{Binding UseFolderCommand}" CommandParameter="en">
                            <TextBlock><Run Text="{infra:Loc model.usefolder}"/><Run Text="  (EN)"/></TextBlock>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="14,0" Margin="0,0,10,6"
                                Command="{Binding UseFolderCommand}" CommandParameter="ar">
                            <TextBlock><Run Text="{infra:Loc model.usefolder}"/><Run Text="  (AR)"/></TextBlock>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="{Binding ModelMessage}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding HasModelMessage, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 4 microphone -->
            <StackPanel Visibility="{Binding IsMicStep, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Muted}" Text="{infra:Loc mic.device}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="Label" AutomationProperties.Name="{infra:Loc mic.device}"/>
                <TextBlock Text="{infra:Loc mic.level}" Style="{StaticResource Muted}" Margin="0,22,0,6"/>
                <Border x:Name="MeterTrack" Height="10" CornerRadius="5" Background="{DynamicResource Surface2Brush}" ClipToBounds="True">
                    <Border HorizontalAlignment="Left" CornerRadius="5" Background="{DynamicResource AccentBrush}">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource LevelToWidth}">
                                <Binding Path="Level"/>
                                <Binding Path="ActualWidth" ElementName="MeterTrack"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Border>
                <TextBlock Text="{Binding MicMessage}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,14,0,0"
                           Visibility="{Binding HasMicMessage, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- 5 listening mode -->
            <StackPanel Visibility="{Binding IsModeStep, Converter={StaticResource BoolToVis}}">
                <RadioButton Style="{StaticResource Segment}" GroupName="mode" Content="{infra:Loc set.mode.ptt}" Margin="0,0,0,8"
                             IsChecked="{Binding IsPushToTalk, Mode=OneWay}" Command="{Binding SetModeCommand}" CommandParameter="PushToTalk"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="mode" Content="{infra:Loc set.mode.always}" Margin="0,0,0,8"
                             IsChecked="{Binding IsAlwaysListening, Mode=OneWay}" Command="{Binding SetModeCommand}" CommandParameter="AlwaysListening"/>
            </StackPanel>

            <!-- 6 try it -->
            <StackPanel Visibility="{Binding IsTryStep, Converter={StaticResource BoolToVis}}">
                <Button Style="{StaticResource PrimaryButton}" Content="{infra:Loc onb.try.run}" Padding="20,0" HorizontalAlignment="Left"
                        Command="{Binding TryItCommand}"/>
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,16,0,0"
                        Visibility="{Binding HasTryResult, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding TryResult}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <!-- 7 done -->
            <StackPanel Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="32" Foreground="{DynamicResource AccentTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,20,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding NextText}" MinWidth="96" Padding="18,0"
                    Command="{Binding NextCommand}" IsDefault="True"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{infra:Loc common.back}" MinWidth="80" Padding="14,0"
                    Margin="0,0,8,0" Command="{Binding BackCommand}"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="{infra:Loc onb.skipmodel}" Padding="14,0"
                    Command="{Binding NextCommand}"
                    Visibility="{Binding CanSkipModel, Converter={StaticResource BoolToVis}}"/>
        </DockPanel>
    </Grid>
</infra:WindowBase>
