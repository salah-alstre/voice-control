<infra:WindowBase x:Class="VoiceCommander.App.Dialogs.CommandEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:VoiceCommander.App.Infrastructure"
        xmlns:inf="clr-namespace:VoiceCommander.App.Infrastructure"
        xmlns:vm="clr-namespace:VoiceCommander.App.ViewModels"
        Title="{Binding WindowTitle}" Width="720" Height="800" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <infra:WindowBase.Resources>

        <!-- Row inside the application dropdown -->
        <Style x:Key="SelectorRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource RadiusSmall}" Padding="8,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The closed selector: always shows the current choice -->
        <Style x:Key="SelectorButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource SubtleBorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="10,7" MinHeight="48">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:PhraseItem}">
            <Border Style="{StaticResource PhraseChip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextBrush}"/>
                    <Button Style="{StaticResource ChipCloseButton}" ToolTip="{inf:Loc edit.action.remove}"
                            Command="{Binding DataContext.RemovePhraseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Application (icon + name + subtitle); used in the list and in the closed selector -->
        <DataTemplate DataType="{x:Type vm:AppChoiceViewModel}">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="32" Height="32" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsVoiceVariable}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="&#xE720;" Style="{StaticResource Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding IsVoiceVariable, Converter={StaticResource BoolToVis}}"/>
                        <Image Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Subtitle, Converter={StaticResource NullToVis}}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Searchable application selector -->
        <DataTemplate DataType="{x:Type vm:AppSelectorState}">
            <StackPanel>
                <Grid>
                    <Button x:Name="SelBtn" Style="{StaticResource SelectorButton}"
                            Command="{Binding ToggleOpenCommand}"
                            IsHitTestVisible="{Binding IsOpen, Converter={StaticResource InvBool}}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Grid>
                                <ContentControl Content="{Binding Selected}"
                                                Visibility="{Binding Selected, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="{inf:Loc edit.app.select}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                           Visibility="{Binding Selected, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                            </Grid>
                        </DockPanel>
                    </Button>

                    <Popup IsOpen="{Binding IsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=SelBtn}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           Width="{Binding ActualWidth, ElementName=SelBtn}">
                        <Border Style="{StaticResource Toast}" Margin="6,4,6,12" Padding="8"
                                Background="{DynamicResource SurfaceBrush}">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Margin="0,0,0,6"
                                         Tag="{inf:Loc edit.app.search}"
                                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                         Loaded="OnSearchLoaded"/>
                                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0"
                                        Margin="0,6,0,0" Padding="0,6,0,0">
                                    <Button Style="{StaticResource SelectorRow}" Command="{Binding AddNewCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="{inf:Loc edit.app.addnew}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Choices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource SelectorRow}"
                                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <ContentControl Content="{Binding}"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{inf:Loc edit.app.noresults}" Style="{StaticResource Muted}"
                                                   HorizontalAlignment="Center" Margin="0,14"
                                                   Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Executable no longer exists -->
                <Border Style="{StaticResource WarningCard}" Margin="0,8,0,0" Padding="12,10"
                        Visibility="{Binding IsExeMissing, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" VerticalAlignment="Center"
                                Content="{inf:Loc edit.app.exe.locate}" Command="{Binding LocateCommand}"/>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="{DynamicResource WarningBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left"/>
                        <TextBlock Text="{inf:Loc edit.app.exe.missing}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Application deleted from the registry -->
                <Border Style="{StaticResource DangerCard}" Margin="0,8,0,0" Padding="14,12"
                        Visibility="{Binding IsAppMissing, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="{DynamicResource DangerBrush}"
                                       VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <StackPanel>
                                <TextBlock Text="{inf:Loc edit.app.missing.title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding MissingName}" Style="{StaticResource Muted}"
                                           Visibility="{Binding MissingName, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="{inf:Loc edit.app.missing.body}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="{inf:Loc edit.app.missing.select}"
                                    Command="{Binding OpenCommand}" Margin="0,0,8,4"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="{inf:Loc edit.app.missing.add}"
                                    Command="{Binding AddNewCommand}" Margin="0,0,8,4"/>
                            <Button Style="{StaticResource DangerButton}" Content="{inf:Loc edit.app.missing.remove}"
                                    Command="{Binding RemoveActionCommand}" Margin="0,0,0,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Any other action parameter -->
        <DataTemplate DataType="{x:Type vm:ParamViewModel}">
            <StackPanel Margin="0,0,0,10" Visibility="{Binding IsApp, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Options}" SelectedValuePath="Value"
                          SelectedValue="{Binding Value}"
                          Visibility="{Binding IsList, Converter={StaticResource BoolToVis}}"/>
                <DockPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="14,0"
                            Content="{inf:Loc common.browse}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseCommand}"
                            Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BoolValue}"
                          Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Numbered action card -->
        <DataTemplate DataType="{x:Type vm:StepViewModel}">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="14,12" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="&#xE768;"
                                    ToolTip="{inf:Loc edit.action.testbtn}" Command="{Binding TestCommand}"
                                    IsEnabled="{Binding Testing, Converter={StaticResource InvBool}}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                    ToolTip="{inf:Loc edit.action.duplicate}" Command="{Binding DuplicateCommand}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE70E;"
                                    ToolTip="{inf:Loc edit.action.up}" Command="{Binding MoveUpCommand}"
                                    IsEnabled="{Binding CanMoveUp}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE70D;"
                                    ToolTip="{inf:Loc edit.action.down}" Command="{Binding MoveDownCommand}"
                                    IsEnabled="{Binding CanMoveDown}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;"
                                    ToolTip="{inf:Loc edit.action.remove}" Command="{Binding RemoveCommand}"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Margin="0,0,10,0"
                                Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Glyph}" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <ContentControl Content="{Binding AppSelector}" Margin="0,12,0,0"
                                    Visibility="{Binding HasAppSelector, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Params}" Margin="0,12,0,0"
                                  Visibility="{Binding HasOtherParams, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{Binding TestBrush, Converter={StaticResource BrushName}}"
                               Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </infra:WindowBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,28,36,20">
                <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource PageTitle}" Margin="0,0,0,26"/>

                <!-- GENERAL -->
                <TextBlock Text="{inf:Loc edit.section.general}" Style="{StaticResource Overline}" Margin="0,0,0,10"/>
                <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{inf:Loc edit.name}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{inf:Loc edit.group}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Categories}" SelectedValuePath="Value" SelectedValue="{Binding Category}"/>
                            </StackPanel>
                        </Grid>
                        <DockPanel Margin="0,14,0,0">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}"/>
                            <TextBlock Text="{inf:Loc edit.enabled}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- VOICE PHRASES -->
                <TextBlock Text="{inf:Loc edit.section.phrases}" Style="{StaticResource Overline}" Margin="0,32,0,10"/>
                <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{inf:Loc edit.phrases.hint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding Phrases}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="14,0"
                                    Content="{inf:Loc edit.phrase.add}" Command="{Binding AddPhraseCommand}"/>
                            <TextBox Tag="{inf:Loc edit.phrase.placeholder}" Text="{Binding NewPhrase, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddPhraseCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- ACTIONS -->
                <TextBlock Text="{inf:Loc edit.section.actions}" Style="{StaticResource Overline}" Margin="0,32,0,10"/>
                <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,14"/>
                <TextBlock Text="{inf:Loc edit.actions.empty}" Style="{StaticResource Muted}" Margin="0,0,0,10"
                           Visibility="{Binding NoSteps, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding Steps}"/>
                <DockPanel Margin="0,2,0,0">
                    <Button DockPanel.Dock="Right" Content="{inf:Loc edit.action.add}" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Padding="16,0" Command="{Binding AddStepCommand}"/>
                    <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}"/>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="0,1,0,0" Padding="36,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{inf:Loc common.cancel}" Style="{StaticResource GhostButton}" MinWidth="88" Margin="0,0,8,0"
                            IsCancel="True" Click="OnCancel"/>
                    <Button Content="{inf:Loc edit.save}" Style="{StaticResource PrimaryButton}" MinWidth="120" Click="OnSave"/>
                </StackPanel>
                <Button DockPanel.Dock="Left" Content="{inf:Loc edit.test}" Style="{StaticResource SecondaryButton}" Padding="14,0"
                        Command="{Binding TestCommand}" IsEnabled="{Binding Testing, Converter={StaticResource InvBool}}"/>
                <StackPanel VerticalAlignment="Center" Margin="14,0">
                    <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap"
                               Foreground="{Binding TestBrush, Converter={StaticResource BrushName}}"
                               Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</infra:WindowBase>
