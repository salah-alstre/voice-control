<infra:WindowBase x:Class="VoiceCommander.App.Dialogs.AppEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:VoiceCommander.App.Infrastructure"
        xmlns:inf="clr-namespace:VoiceCommander.App.Infrastructure"
        Title="{Binding WindowTitle}" Width="640" Height="780" MinWidth="540" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,28,36,20">
                <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource PageTitle}" Margin="0,0,0,26"/>

                <!-- PROGRAM -->
                <TextBlock Text="{inf:Loc apps.section.target}" Style="{StaticResource Overline}" Margin="0,0,0,10"/>
                <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{inf:Loc apps.path}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="16,0" Content="{inf:Loc common.browse}"
                                    Style="{StaticResource SecondaryButton}" Command="{Binding BrowseCommand}"/>
                            <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{inf:Loc apps.path}"/>
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="8,0,0,0" VerticalAlignment="Top"
                                    Visibility="{Binding KindText, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding KindText}" Style="{StaticResource Caption}"/>
                            </Border>
                            <TextBlock Text="{inf:Loc apps.path.hint}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Text="{inf:Loc apps.notfound}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                   Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="{inf:Loc apps.args}" Style="{StaticResource Muted}" Margin="0,16,0,4"/>
                        <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="{inf:Loc apps.workdir}" Style="{StaticResource Muted}" Margin="0,16,0,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="16,0" Content="{inf:Loc common.browse}"
                                    Style="{StaticResource SecondaryButton}" Command="{Binding BrowseWorkingDirectoryCommand}"/>
                            <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- IDENTITY -->
                <TextBlock Text="{inf:Loc apps.section.identity}" Style="{StaticResource Overline}" Margin="0,32,0,10"/>
                <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                    <StackPanel>
                        <DockPanel>
                            <!-- icon preview + change/reset -->
                            <StackPanel DockPanel.Dock="Left" Width="96" Margin="0,0,18,0">
                                <Border Style="{StaticResource IconTile}" Width="64" Height="64" CornerRadius="12" HorizontalAlignment="Left">
                                    <Grid>
                                        <Image Source="{Binding Icon}" Width="40" Height="40" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding Initial}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                    </Grid>
                                </Border>
                                <Button Content="{inf:Loc apps.icon.change}" Style="{StaticResource GhostButton}" Margin="0,8,0,0" Padding="0,4"
                                        HorizontalAlignment="Left" Command="{Binding ChangeIconCommand}"/>
                                <Button Content="{inf:Loc apps.icon.reset}" Style="{StaticResource GhostButton}" Padding="0,4" HorizontalAlignment="Left"
                                        Command="{Binding ResetIconCommand}"
                                        Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{inf:Loc apps.name}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{inf:Loc apps.process}" Style="{StaticResource Muted}" Margin="0,16,0,4"/>
                                <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{inf:Loc apps.process.hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="{inf:Loc apps.aliases}" Style="{StaticResource Muted}" Margin="0,18,0,4"/>
                        <TextBox Text="{Binding AliasesText, UpdateSourceTrigger=PropertyChanged}" Height="84"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 AutomationProperties.Name="{inf:Loc apps.aliases}"/>
                        <TextBlock Text="{inf:Loc apps.aliases.hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- OPTIONS -->
                <TextBlock Text="{inf:Loc apps.section.options}" Style="{StaticResource Overline}" Margin="0,32,0,10"/>
                <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding SingleInstance}" Margin="16,0,0,0"/>
                            <TextBlock Text="{inf:Loc apps.single}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Style="{StaticResource Divider}" Margin="0,14"/>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ForceClose}" Margin="16,0,0,0"/>
                            <TextBlock Text="{inf:Loc apps.force}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="0,1,0,0" Padding="36,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{inf:Loc common.cancel}" Style="{StaticResource GhostButton}" MinWidth="88" Margin="0,0,8,0"
                            IsCancel="True" Click="OnCancel"/>
                    <Button Content="{inf:Loc apps.save}" Style="{StaticResource PrimaryButton}" MinWidth="140" Click="OnSave"/>
                </StackPanel>
                <Button DockPanel.Dock="Left" Content="{inf:Loc apps.test}" Style="{StaticResource SecondaryButton}" Padding="14,0"
                        Command="{Binding TestCommand}" IsEnabled="{Binding Testing, Converter={StaticResource InvBool}}"/>
                <StackPanel VerticalAlignment="Center" Margin="14,0">
                    <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap"
                               Foreground="{Binding TestBrush, Converter={StaticResource BrushName}}"
                               Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</infra:WindowBase>
